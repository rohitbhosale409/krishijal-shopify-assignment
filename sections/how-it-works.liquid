
<section id="how-it-works" class="section">
  <div class="container center">
    <span class="eyebrow">Simple application</span>
    <h2>{{ section.settings.heading }}</h2>
    <p class="lead">{{ section.settings.text }}</p>

    <div class="steps-grid">
      {% for block in section.blocks %}
        <article class="step reveal" {{ block.shopify_attributes }}>
          <div class="step-num">0{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"How It Works",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"A simple 3-step process"},
    {"type":"textarea","id":"text","label":"Description","default":"Easy to apply, easy to repeat, and designed for consistent results."}
  ],
  "blocks":[
    {"type":"step","name":"Step","settings":[
      {"type":"text","id":"title","label":"Title","default":"Dissolve"},
      {"type":"textarea","id":"text","label":"Description","default":"Open one capsule and add it to 1 glass (200–250 ml) of clean water."}
    ]}
  ],
  "presets":[
    {"name":"How It Works","blocks":[
      {"type":"step","settings":{"title":"Dissolve","text":"Open one capsule and add it to 1 glass (200–250 ml) of clean water."}},
      {"type":"step","settings":{"title":"Activate","text":"Stir well and let it stand for 1–2 hours for best results."}},
      {"type":"step","settings":{"title":"Apply","text":"Pour the prepared solution into a 15 L sprayer tank, fill with water and spray evenly on crops."}}
    ]}
  ]
}
{% endschema %}

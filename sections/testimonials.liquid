
<section class="section testimonials">
  <div class="container center">
    <span class="eyebrow">Built for confidence</span>
    <h2>{{ section.settings.heading }}</h2>
    <p class="lead">{{ section.settings.text }}</p>

    <div class="testimonial-grid">
      {% for block in section.blocks %}
        <article class="testimonial reveal" {{ block.shopify_attributes }}>
          <div class="stars">★★★★★</div>
          <p>“{{ block.settings.quote }}”</p>
          <strong>{{ block.settings.name }}</strong>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Testimonials",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"A better foundation for every harvest"},
    {"type":"textarea","id":"text","label":"Description","default":"Use this section for farmer reviews, field results or brand proof as real customer feedback becomes available."}
  ],
  "blocks":[
    {"type":"review","name":"Review","settings":[
      {"type":"textarea","id":"quote","label":"Quote","default":"The easy application makes it simple to add soil care to our regular crop routine."},
      {"type":"text","id":"name","label":"Name","default":"Farmer / Customer"}
    ]}
  ],
  "presets":[
    {"name":"Testimonials","blocks":[
      {"type":"review","settings":{"quote":"The easy application makes it simple to add soil care to our regular crop routine.","name":"Farmer / Customer"}},
      {"type":"review","settings":{"quote":"The product story is clear and the capsule format is very convenient.","name":"Agriculture Professional"}},
      {"type":"review","settings":{"quote":"A practical approach to improving soil health while caring for the land.","name":"KrishiJal Community"}}
    ]}
  ]
}
{% endschema %}

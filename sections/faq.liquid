
<section id="faq" class="section">
  <div class="container">
    <div class="center reveal">
      <span class="eyebrow">Need to know</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="faq-list">
      {% for block in section.blocks %}
        <div class="faq-item reveal" data-faq {{ block.shopify_attributes }}>
          <button class="faq-q" data-faq-button aria-expanded="false">
            {{ block.settings.question }}
            <span aria-hidden="true">+</span>
          </button>
          <div class="faq-a">{{ block.settings.answer }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"FAQ",
  "settings":[{"type":"text","id":"heading","label":"Heading","default":"Frequently asked questions"}],
  "blocks":[
    {"type":"faq","name":"Question","settings":[
      {"type":"text","id":"question","label":"Question","default":"Is KrishiJal suitable for all crops?"},
      {"type":"textarea","id":"answer","label":"Answer","default":"The assignment brief states that the flagship product is suitable for all crops."}
    ]}
  ],
  "presets":[
    {"name":"FAQ","blocks":[
      {"type":"faq","settings":{"question":"Is KrishiJal suitable for all crops?","answer":"Yes. The assignment brief describes the flagship Humic + Fulvic Soil Conditioner as suitable for all crops."}},
      {"type":"faq","settings":{"question":"What are the key ingredients?","answer":"The brief states that the product is enriched with 70% Potassium Humate and 25% Fulvic Acid."}},
      {"type":"faq","settings":{"question":"How is it applied?","answer":"The provided product image describes a 3-step process: dissolve, activate and apply."}},
      {"type":"faq","settings":{"question":"What makes the product convenient?","answer":"The brief highlights water-soluble capsule technology for easy application and consistent results."}}
    ]}
  ]
}
{% endschema %}
